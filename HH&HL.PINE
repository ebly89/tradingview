//@version=5
indicator("HA Fractal Market Structure", overlay=true, max_labels_count=500)

// --- קלט: מרחק מינימלי בין פיבוטים ---
minBarsBetweenPivots = input.int(5, "Min Bars Between Pivots", minval=1)

// --- קבלת מחירים אמיתיים (מנותקים מסוג הגרף) ---
trueTicker = ticker.new(syminfo.prefix, syminfo.ticker)
[trueOpen, trueHigh, trueLow, trueClose] = request.security(trueTicker, timeframe.period, [open, high, low, close])

// --- Heikin Ashi Calculation (מבוסס על מחירים אמיתיים) ---
haClose = (trueOpen + trueHigh + trueLow + trueClose) / 4
var float haOpen = na
haOpen := na(haOpen[1]) ? (trueOpen + trueClose) / 2 : (haOpen[1] + haClose[1]) / 2

isGreenHA = haClose > haOpen
isRedHA   = haClose < haOpen

// --- מונים לרצפים מיידיים (לצורך זיהוי 2 נרות) ---
var int greenRun = 0
var int redRun   = 0

greenRun := isGreenHA ? greenRun[1] + 1 : 0
redRun   := isRedHA   ? redRun[1] + 1   : 0

// --- ניהול מגמה מורחבת: שינוי כיוון רק אחרי 2 נרות נגדיים ---
var int trend         = 0   // 1 = עליות, -1 = ירידות
var int trendBars     = 0
var int lastUpWave    = 0
var int lastDownWave  = 0

// --- דגלים זמניים לסריקה ---
var bool scanHighNow = false
var bool scanLowNow  = false

// לוגיקת מהפך
if trend == 0
    if isGreenHA
        trend := 1
        trendBars := 1
        lastUpWave := 0
    else if isRedHA
        trend := -1
        trendBars := 1
        lastDownWave := 0
else if trend == 1
    if isGreenHA
        trendBars := trendBars + 1
    else if isRedHA
        trendBars := trendBars + 1
        if redRun == 2
            bool complexTransition = isRedHA[0] and isRedHA[1] and isGreenHA[2] and isRedHA[3]
            lastUpWave := trendBars - 2
            scanHighNow := true
            trend := -1
            trendBars := complexTransition ? 4 : 2
else if trend == -1
    if isRedHA
        trendBars := trendBars + 1
    else if isGreenHA
        trendBars := trendBars + 1
        if greenRun == 2
            bool complexTransition = isGreenHA[0] and isGreenHA[1] and isRedHA[2] and isGreenHA[3]
            lastDownWave := trendBars - 2
            scanLowNow := true
            trend := 1
            trendBars := complexTransition ? 4 : 2

// --- משתני מצב למבנה השוק ---
var float lastPivotHigh    = na
var float lastPivotLow     = na
var int   lastPivotHighBar = na
var int   lastPivotLowBar  = na
var float prevPivotHigh    = na
var float prevPivotLow     = na
var label lastHighLabel    = na
var label lastLowLabel     = na

// --- Visuals ---
colorHigh = color.new(#c23131, 30)
colorLow  = color.new(#0a846d, 30)

// --- פונקציה לבדיקת פיבוט קלאסי ב-HA ---
isPivotHigh(i) =>
    i > 0 and i < bar_index - 1 ? 
      haHigh[i] > haHigh[i-1] and haHigh[i] > haHigh[i+1] and 
      haHigh[i] > haClose[i-1] and haHigh[i] > haClose[i+1] : false

isPivotLow(i) =>
    i > 0 and i < bar_index - 1 ? 
      haLow[i] < haLow[i-1] and haLow[i] < haLow[i+1] and 
      haLow[i] < haClose[i-1] and haLow[i] < haClose[i+1] : false

// חישוב HA High/Low לצורך בדיקת פיבוטים
haHigh = math.max(haOpen, haClose)
haLow = math.min(haOpen, haClose)

// --- פונקציה לבדיקת מרחק מינימלי מפיבוטים קיימים ---
checkMinDistance(pivotBar, lastPivotBar, prevPivotBar) =>
    bool validDist = true
    if not na(lastPivotBar)
        validDist := math.abs(pivotBar - lastPivotBar) > minBarsBetweenPivots
    if not na(prevPivotBar) and validDist
        validDist := math.abs(pivotBar - prevPivotBar) > minBarsBetweenPivots
    validDist

// --- High Detection (עם איחוד) ---
if scanHighNow
    scanHighNow := false
    int windowSize = lastUpWave + 2
    
    float highestVal = trueHigh[0]
    int highestIdx = 0
    
    for i = 0 to 200
        if i < windowSize
            if trueHigh[i] > highestVal
                highestVal := trueHigh[i]
                highestIdx := i
        else
            break

    int pivotBarIndex = bar_index - highestIdx

    // בדיקת מרחק מהשיא הקודם
    if not na(lastPivotHighBar) and (pivotBarIndex - lastPivotHighBar <= minBarsBetweenPivots)
        // איחוד: שומרים על הגבוה יותר
        if highestVal > lastPivotHigh
            // החדש גבוה יותר – מחליפים
            label.delete(lastHighLabel)
            string labelText = na(prevPivotHigh) ? "H" : (highestVal > prevPivotHigh ? "HH" : "LH")
            lastHighLabel := label.new(bar_index[highestIdx], trueHigh[highestIdx], text=labelText, color=colorHigh, textcolor=color.white, style=label.style_label_down, yloc=yloc.price, size=size.small)
            lastPivotHigh    := highestVal
            lastPivotHighBar := pivotBarIndex
            // prevPivotHigh נותר כפי שהוא
    else
        // שיא תקף, לא צמוד
        string labelText = na(lastPivotHigh) ? "H" : (highestVal > lastPivotHigh ? "HH" : "LH")
        lastHighLabel := label.new(bar_index[highestIdx], trueHigh[highestIdx], text=labelText, color=colorHigh, textcolor=color.white, style=label.style_label_down, yloc=yloc.price, size=size.small)
        prevPivotHigh    := lastPivotHigh
        lastPivotHigh    := highestVal
        lastPivotHighBar := pivotBarIndex

// --- Low Detection (עם איחוד) ---
if scanLowNow
    scanLowNow := false
    int windowSize = lastDownWave + 2
    
    float lowestVal = trueLow[0]
    int lowestIdx = 0
    
    for i = 0 to 200
        if i < windowSize
            if trueLow[i] < lowestVal
                lowestVal := trueLow[i]
                lowestIdx := i
        else
            break

    int pivotBarIndex = bar_index - lowestIdx

    if not na(lastPivotLowBar) and (pivotBarIndex - lastPivotLowBar <= minBarsBetweenPivots)
        // איחוד: שומרים על הנמוך יותר
        if lowestVal < lastPivotLow
            label.delete(lastLowLabel)
            string labelText = na(prevPivotLow) ? "L" : (lowestVal > prevPivotLow ? "HL" : "LL")
            lastLowLabel := label.new(bar_index[lowestIdx], trueLow[lowestIdx], text=labelText, color=colorLow, textcolor=color.white, style=label.style_label_up, yloc=yloc.price, size=size.small)
            lastPivotLow    := lowestVal
            lastPivotLowBar := pivotBarIndex
    else
        string labelText = na(lastPivotLow) ? "L" : (lowestVal > lastPivotLow ? "HL" : "LL")
        lastLowLabel := label.new(bar_index[lowestIdx], trueLow[lowestIdx], text=labelText, color=colorLow, textcolor=color.white, style=label.style_label_up, yloc=yloc.price, size=size.small)
        prevPivotLow    := lastPivotLow
        lastPivotLow    := lowestVal
        lastPivotLowBar := pivotBarIndex

// --- מנגנון רטרואקטיבי לזיהוי שיאים/שפלים מפוספסים ---
// משתנים לשמירת היסטוריית פיבוטים עיקריים
var int[] pivotHighBars = array.new_int()
var float[] pivotHighValues = array.new_float()
var int[] pivotLowBars = array.new_int()
var float[] pivotLowValues = array.new_float()

// משתנים למעקב אחר שינויים בפיבוטים
var int savedLastPivotHighBar = na
var int savedLastPivotLowBar = na

// פונקציה לבדיקת פיבוט קלאסי ב-HA (לשימוש במנגנון הרטרואקטיבי)
isClassicPivotHigh(idx) =>
    idx > 0 and idx < bar_index - 1 ? 
      haHigh[idx] > haHigh[idx-1] and haHigh[idx] > haHigh[idx+1] and 
      haHigh[idx] > haClose[idx-1] and haHigh[idx] > haClose[idx+1] : false

isClassicPivotLow(idx) =>
    idx > 0 and idx < bar_index - 1 ? 
      haLow[idx] < haLow[idx-1] and haLow[idx] < haLow[idx+1] and 
      haLow[idx] < haClose[idx-1] and haLow[idx] < haClose[idx+1] : false

// פונקציה לסריקה רטרואקטיבית של פיבוטים מפוספסים בין שני פיבוטים עיקריים
findMissedPivots(bool isHigh, int currentPivotBar, float currentPivotVal, int[] pivotBars, float[] pivotValues, color labelColor) =>
    // צריך לפחות פיבוט אחד קודם כדי לחפש בינו לבין הנוכחי
    if array.size(pivotBars) >= 1
        int prevMainPivotBar = array.get(pivotBars, array.size(pivotBars) - 1)
        float prevMainPivotVal = array.get(pivotValues, array.size(pivotValues) - 1)
        
        // הגבלת טווח הסריקה למקסימום 500 נרות אחורה למניעת ביצועים איטיים
        int searchStart = math.max(prevMainPivotBar + 1, currentPivotBar - 500)
        int searchEnd = currentPivotBar - 1
        
        // סריקה מהפיבוט הקודם ועד הנוכחי (לא כולל)
        for i = searchStart to searchEnd
            int lookbackIdx = i
            bool isPivot = false
            
            // בדיקה שהאינדקס תקין ויש מספיק נרות מסביב לבדיקת פיבוט
            if lookbackIdx > 1 and lookbackIdx < bar_index - 2
                if isHigh
                    isPivot := isClassicPivotHigh(lookbackIdx)
                else
                    isPivot := isClassicPivotLow(lookbackIdx)
            
            if isPivot
                float pivotVal = isHigh ? haHigh[lookbackIdx] : haLow[lookbackIdx]
                int pivotBar = lookbackIdx
                
                // בדיקת מרחק מינימלי מהפיבוט הקודם במערך
                bool validDistFromPrev = true
                if array.size(pivotBars) > 0
                    int lastBar = array.get(pivotBars, array.size(pivotBars) - 1)
                    if math.abs(pivotBar - lastBar) <= minBarsBetweenPivots
                        validDistFromPrev := false
                
                // בדיקת מרחק מינימלי מהפיבוט הנוכחי (זה שטריגר את הסריקה)
                bool validDistFromCurrent = math.abs(currentPivotBar - pivotBar) > minBarsBetweenPivots
                
                // בדיקה שהפיבוט לא כבר סומן במערך
                bool alreadyMarked = false
                for j = 0 to array.size(pivotBars) - 1
                    if array.get(pivotBars, j) == pivotBar
                        alreadyMarked := true
                        break
                
                // בדיקה שהפיבוט נמצא בטווח הנכון (בין הקודם לנוכחי)
                bool inRange = pivotBar > prevMainPivotBar and pivotBar < currentPivotBar
                
                if validDistFromPrev and validDistFromCurrent and not alreadyMarked and inRange
                    // קביעת סוג הפיבוט בהשוואה לפיבוט הקודם
                    string labelText = ""
                    if isHigh
                        labelText := pivotVal > prevMainPivotVal ? "HH" : "LH"
                    else
                        labelText := pivotVal > prevMainPivotVal ? "HL" : "LL"
                    
                    // יצירת תווית עם אותו סגנון כמו הפיבוטים הרגילים
                    labelStyle = isHigh ? label.style_label_down : label.style_label_up
                    priceLevel = isHigh ? haHigh[lookbackIdx] : haLow[lookbackIdx]
                    label.new(pivotBar, priceLevel, text=labelText, color=labelColor, textcolor=color.white, style=labelStyle, yloc=yloc.price, size=size.small)
                    
                    // הוספה למערך כדי למנוע סימון כפול בפעמים הבאות
                    array.push(pivotBars, pivotBar)
                    array.push(pivotValues, pivotVal)
    
    // הוספת הפיבוט הנוכחי למערך (אחרי הסריקה)
    array.push(pivotBars, currentPivotBar)
    array.push(pivotValues, currentPivotVal)

// הפעלת המנגנון הרטרואקטיבי לאחר זיהוי פיבוט חדש
bool highJustDetected = not na(lastPivotHighBar) and (na(savedLastPivotHighBar) or lastPivotHighBar != savedLastPivotHighBar)
bool lowJustDetected = not na(lastPivotLowBar) and (na(savedLastPivotLowBar) or lastPivotLowBar != savedLastPivotLowBar)

if highJustDetected and not na(lastPivotHigh)
    findMissedPivots(true, lastPivotHighBar, lastPivotHigh, pivotHighBars, pivotHighValues, colorHigh)
    savedLastPivotHighBar := lastPivotHighBar

if lowJustDetected and not na(lastPivotLow)
    findMissedPivots(false, lastPivotLowBar, lastPivotLow, pivotLowBars, pivotLowValues, colorLow)
    savedLastPivotLowBar := lastPivotLowBar
